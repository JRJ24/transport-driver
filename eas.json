{
  "cli": {
    "version": ">=21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "IOS_APS_ENVIRONMENT": "development"
      }
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "IOS_APS_ENVIRONMENT": "production"
      }
    },

    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "IOS_APS_ENVIRONMENT": "production"
      }
    }
  },

  "submit": {
    "production": {}
  }
}