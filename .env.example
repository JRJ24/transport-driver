# Base URL of transport-api (include the /api/v1 prefix)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Socket.IO origin (no path)
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
# Google Maps SDK keys — RESTRICTED per platform in Google Cloud.
#   Android: restrict by package name + SHA-1/SHA-256
#   iOS: restrict by bundle identifier
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
