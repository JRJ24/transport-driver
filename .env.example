# Base URL of transport-api (include the /api/v1 prefix)
# EAS Build no recibe este archivo (.env esta en .gitignore): para los builds
# EAS los mismos valores viven en el bloque `env` de cada perfil de eas.json.
# https://conductores.larutard.com.do es un origen equivalente: tambien proxya
# /api y /socket.io (usar .../api/v1 y el origen sin path).
EXPO_PUBLIC_API_URL=https://api.larutard.com.do/api/v1
# Socket.IO origin (no path). Si falta, la app usa el origen de EXPO_PUBLIC_API_URL
EXPO_PUBLIC_SOCKET_URL=https://api.larutard.com.do
# Google Maps SDK keys — RESTRICTED per platform in Google Cloud.
#   Android: restrict by package name + SHA-1/SHA-256
#   iOS: restrict by bundle identifier
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
